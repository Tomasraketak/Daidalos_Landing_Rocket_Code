+  // --- Per-sample tap (optional) ---
+  // Called with every sample readIMU()/readFIFO() hands out, in the same
+  // calibrated units (g, deg/s), after the caller's read succeeded. Lets a
+  // sketch see the full-rate stream while another consumer (a fusion
+  // library) owns the FIFO: reading the FIFO a second time would steal
+  // samples from it. Runs in the reader's context - keep it short and
+  // non-blocking (copy into a ring buffer and return). nullptr disables it.
+  // Cost when unused: one pointer test per sample.
+  typedef void (*SampleTap)(const float acc_g[3], const float gyr_dps[3], void *ctx);
+  void setSampleTap(SampleTap fn, void *ctx = nullptr) { _sampleTap = fn; _sampleTapCtx = ctx; }
